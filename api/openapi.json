{
  "openapi": "3.1.0",
  "info": {"title": "BeaconForge DORA API", "version": "0.1.0", "description": "Local-first deployment and incident metrics. Missing evidence is reported as unknown."},
  "servers": [{"url": "http://127.0.0.1:8081"}],
  "security": [{"ProjectKey": []}],
  "paths": {
    "/health/live": {"get": {"operationId": "liveness", "security": [], "responses": {"200": {"description": "Process is serving", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}},
    "/health/ready": {"get": {"operationId": "readiness", "security": [], "responses": {"200": {"description": "Database is available", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/events": {
      "post": {
        "operationId": "acceptEvent",
        "parameters": [
          {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 160}},
          {"name": "X-BeaconForge-Signature", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^sha256=[0-9a-f]{64}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Event"}}}},
        "responses": {
          "202": {"description": "Durably accepted or identical delivery already accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Receipt"}}}},
          "401": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      },
      "get": {
        "operationId": "listEvents",
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 512}}],
        "responses": {"200": {"description": "Project-scoped event page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/v1/events/{event_id}/replay": {"post": {"operationId": "replayEvent", "parameters": [{"name": "event_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"202": {"description": "Dead-letter event durably requeued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Receipt"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/metrics": {"get": {"operationId": "readMetrics", "parameters": [{"name": "start", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}, {"name": "end", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}], "responses": {"200": {"description": "UTC-day rollup report with evidence coverage", "content": {"application/json": {"schema": {"type": "object", "required": ["project_id", "start", "end", "metrics", "coverage"]}}}}, "401": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"ProjectKey": {"type": "apiKey", "in": "header", "name": "X-Project-Key"}},
    "responses": {"Problem": {"description": "RFC 9457 problem response", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}},
    "schemas": {
      "Health": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}},
      "Problem": {"type": "object", "required": ["type", "title", "status", "detail", "instance"], "properties": {"type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}, "instance": {"type": "string"}}},
      "Commit": {"type": "object", "additionalProperties": false, "required": ["sha", "authored_at"], "properties": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "authored_at": {"type": "string", "format": "date-time"}}},
      "Event": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "external_id", "occurred_at"],
        "properties": {
          "kind": {"type": "string", "enum": ["deployment", "incident", "restoration"]},
          "external_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "occurred_at": {"type": "string", "format": "date-time"},
          "environment": {"type": "string", "default": "production"},
          "outcome": {"type": "string", "enum": ["success", "failure"], "default": "success"},
          "commit_scope": {"type": "string", "enum": ["complete", "head_only", "unknown"], "default": "unknown"},
          "commits": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/Commit"}},
          "deployment_id": {"type": ["string", "null"], "maxLength": 160},
          "incident_id": {"type": ["string", "null"], "maxLength": 160},
          "restored_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "incident"}}}, "then": {"required": ["deployment_id"], "properties": {"deployment_id": {"type": "string", "minLength": 1}}}},
          {"if": {"properties": {"kind": {"const": "restoration"}}}, "then": {"required": ["incident_id"], "properties": {"incident_id": {"type": "string", "minLength": 1}}}}
        ]
      },
      "Receipt": {"type": "object", "required": ["event_id", "status", "duplicate"], "properties": {"event_id": {"type": "string", "format": "uuid"}, "status": {"type": "string"}, "duplicate": {"type": "boolean"}}},
      "EventPage": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"type": "object", "required": ["event_id", "kind", "status", "received_at"]}}, "next_cursor": {"type": ["string", "null"]}}}
    }
  }
}