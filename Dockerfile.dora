FROM python:3.13-slim@sha256:bb2988715db2cf7ace7b53f38f3cffbef7c7046a656bee66245eb0ed386e2e81
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY api ./api
RUN --mount=type=secret,id=extra_ca if [ -f /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi; pip install --no-cache-dir . && useradd --uid 10001 --create-home beaconforge && mkdir /app/.local && chown beaconforge:beaconforge /app/.local
USER 10001:10001
EXPOSE 8081
CMD ["uvicorn", "beaconforge.api:application", "--factory", "--host", "0.0.0.0", "--port", "8081", "--no-access-log"]